{
  "name": "lmrchip-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Desktop control application for the LMRChip experimental system",
  "main": "dist-electron/main/main.js",
  "scripts": {
    "build": "npm run build:electron && npm run build:renderer",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build:renderer": "tsc -p tsconfig.renderer.json && vite build",
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"npm:dev:electron\"",
    "dev:electron": "npm run build:electron && wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .",
    "start": "npm run build && electron .",
    "test": "vitest run",
    "prepare:python": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-python-runtime.ps1",
    "package:win": "npm run prepare:python && npm run build && electron-builder --win nsis portable",
    "package:dir": "npm run prepare:python && npm run build && electron-builder --win --dir"
  },
  "build": {
    "appId": "co.lmrchip.desktop",
    "productName": "LMRChip Desktop",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist-electron/**/*",
      "dist/renderer/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/python-runtime",
        "to": "python-runtime"
      },
      {
        "from": "python",
        "to": "python",
        "filter": [
          "lmrchip/**/*.py"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "artifactName": "LMRChip-Desktop-Setup-${version}-${arch}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "LMRChip Desktop"
    },
    "portable": {
      "artifactName": "LMRChip-Desktop-Portable-${version}-${arch}.${ext}"
    }
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "concurrently": "10.0.6",
    "cross-env": "10.1.0",
    "electron": "44.7.2",
    "electron-builder": "26.15.3",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.4",
    "wait-on": "9.5.1"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "overrides": {
    "sprintf-js": "1.1.4"
  }
}
